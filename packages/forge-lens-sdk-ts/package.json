{
  "name": "@forge-lens/sdk",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript SDK for Forge Lens agentic observability.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
