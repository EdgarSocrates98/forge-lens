{
  "scenario_id": "tenancy-cross-project-write",
  "title": "A tenant-a writer cannot ingest a trace that declares tenant-b — 403, nothing stored",
  "category": "tenancy",
  "setup": {
    "config": {"auth_mode": "keys"},
    "api_keys": [
      {
        "key_id": "flk_writera",
        "name": "writer-a",
        "secret": "flk_test_writer_a",
        "role": "writer",
        "projects": ["tenant-a"]
      }
    ]
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "headers": {"X-Forge-Lens-Key": "flk_test_writer_a"},
        "json": {
          "project_id": "tenant-a",
          "traces": [
            {
              "trace_id": "d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5",
              "project_id": "tenant-b",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.100000Z",
              "spans": [
                {
                  "trace_id": "d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5",
                  "span_id": "1212121212121212",
                  "name": "smuggled",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 403,
    "body_contains": ["outside key scope"],
    "store": {"trace_count": 0, "span_count": 0}
  },
  "forbidden": {"status_not": [200, 500]},
  "notes": "The envelope names tenant-a (in scope) but the trace itself declares tenant-b: a trace's own project_id is authoritative, so the per-trace scope check fires. The whole request is refused before ingest — no partial write into a foreign tenant."
}
