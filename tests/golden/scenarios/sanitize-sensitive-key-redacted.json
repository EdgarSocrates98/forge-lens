{
  "scenario_id": "sanitize-sensitive-key-redacted",
  "title": "Credential-shaped attribute keys are redacted at ingest, counted in sanitize",
  "category": "sanitize",
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "abababababababababababababababab",
              "root_span_id": "1010101010101010",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.100000Z",
              "spans": [
                {
                  "trace_id": "abababababababababababababababab",
                  "span_id": "1010101010101010",
                  "name": "llm call",
                  "kind": "llm",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "attributes": {
                    "openai.api_key": "sk-test-abcdef1234567890",
                    "safe.field": "keep-me",
                    "forge_lens.token_usage": {"model": "gpt-test", "total_tokens": 7}
                  },
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"accepted_spans": 1, "sanitize": {"redacted_keys": 1}},
    "store": {
      "span_attrs": {
        "abababababababababababababababab/1010101010101010": {
          "openai.api_key": "[REDACTED:key]",
          "safe.field": "keep-me"
        }
      },
      "span_flag_absent": {
        "abababababababababababababababab/1010101010101010": ["unknown_tokens"]
      }
    }
  },
  "forbidden": {
    "body_not_contains": ["sk-test-abcdef1234567890"],
    "store_json_not_contains": ["sk-test-abcdef1234567890"]
  },
  "notes": "SENSITIVE_KEY_RE matches 'api_key' — value destroyed at the boundary, key name preserved. The token_usage dict is legitimate telemetry and survives (no *key suffix)."
}
