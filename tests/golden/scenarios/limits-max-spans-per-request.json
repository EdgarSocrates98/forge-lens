{
  "scenario_id": "limits-max-spans-per-request",
  "title": "A batch over max_spans_per_request is refused 413 with the count named",
  "category": "limits",
  "setup": {
    "config": {"max_spans_per_request": 1}
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.200000Z",
              "spans": [
                {
                  "trace_id": "d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1",
                  "span_id": "1111111111111111",
                  "name": "one",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                },
                {
                  "trace_id": "d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1",
                  "span_id": "2222222222222222",
                  "parent_span_id": "1111111111111111",
                  "name": "two",
                  "start_time": "2026-01-01T12:00:00.010000Z",
                  "end_time": "2026-01-01T12:00:00.150000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 413,
    "body_contains": ["2 spans exceeds limit 1"],
    "store": {"trace_count": 0, "span_count": 0}
  },
  "forbidden": {"status_not": [200, 500]},
  "notes": "The batch limit is a PayloadTooLargeError too — the rejection names the observed count and the configured limit, and the whole batch is refused atomically (nothing half-written)."
}
