{
  "scenario_id": "integrity-missing-parent",
  "title": "A span referencing an absent parent gets missing_parent + a warning",
  "category": "integrity",
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc",
              "root_span_id": "1111111111111111",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.200000Z",
              "spans": [
                {
                  "trace_id": "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc",
                  "span_id": "1111111111111111",
                  "name": "root",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.200000Z",
                  "status": {"code": "ok"}
                },
                {
                  "trace_id": "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc",
                  "span_id": "2222222222222222",
                  "parent_span_id": "9999999999999999",
                  "name": "child-of-nowhere",
                  "start_time": "2026-01-01T12:00:00.010000Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"accepted_spans": 2},
    "json_contains": {"warnings": ["reference parents not present"]},
    "store": {
      "span_flags": {
        "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc/2222222222222222": ["missing_parent"]
      },
      "span_flag_absent": {
        "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc/2222222222222222": ["orphan"],
        "bcbcbcbcbcbcbcbcbcbcbcbcbcbcbcbc/1111111111111111": ["missing_parent"]
      }
    }
  },
  "forbidden": {"status_not": [500]},
  "notes": "Absent parents are never fabricated: the flag + warning record the gap. 'orphan' does NOT apply — the parent is absent from the whole store, not just this trace."
}
