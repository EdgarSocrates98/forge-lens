{
  "scenario_id": "dedupe-conflict-redelivery",
  "title": "Same span key, different identity → CONFLICT flag, first-observed name wins",
  "category": "dedupe",
  "setup": {
    "ingest_traces": [
      {
        "trace_id": "ffffffffffffffffffffffffffffffff",
        "root_span_id": "7777777777777777",
        "started_at": "2026-01-01T12:00:00Z",
        "ended_at": "2026-01-01T12:00:00.100000Z",
        "spans": [
          {
            "trace_id": "ffffffffffffffffffffffffffffffff",
            "span_id": "7777777777777777",
            "name": "op-v1",
            "start_time": "2026-01-01T12:00:00Z",
            "end_time": "2026-01-01T12:00:00.100000Z",
            "status": {"code": "ok"}
          }
        ]
      }
    ]
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "ffffffffffffffffffffffffffffffff",
              "root_span_id": "7777777777777777",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.100000Z",
              "spans": [
                {
                  "trace_id": "ffffffffffffffffffffffffffffffff",
                  "span_id": "7777777777777777",
                  "name": "op-v2",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"accepted_spans": 0, "updated_spans": 0, "duplicate_spans": 1},
    "store": {
      "trace_count": 1,
      "span_count": 1,
      "spans": {
        "ffffffffffffffffffffffffffffffff/7777777777777777": {"name": "op-v1"}
      },
      "span_flags": {
        "ffffffffffffffffffffffffffffffff/7777777777777777": ["conflict"]
      }
    }
  },
  "forbidden": {"status_not": [500]},
  "notes": "name/kind/start_time are merge-untouched identity fields: a differing re-delivery counts as a duplicate but earns 'conflict' — the stored name stays first-observed ('op-v1')."
}
