{
  "scenario_id": "audit-key-create",
  "title": "Minting a managed key writes a key.create audit event — never the secret",
  "category": "audit",
  "setup": {
    "config": {"auth_mode": "keys"},
    "api_keys": [
      {
        "key_id": "flk_root00",
        "name": "root-admin",
        "secret": "flk_test_root_admin",
        "role": "admin",
        "projects": []
      }
    ]
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/admin/keys",
        "headers": {"X-Forge-Lens-Key": "flk_test_root_admin"},
        "json": {
          "name": "reader-bot",
          "role": "reader",
          "projects": ["tenant-a"]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"role": "reader", "projects": ["tenant-a"]},
    "body_contains": ["the secret is shown once"],
    "store": {
      "audit": [
        {
          "action": "key.create",
          "actor": "key:flk_root00",
          "outcome": "ok",
          "detail": {"name": "reader-bot", "role": "reader"}
        }
      ]
    }
  },
  "forbidden": {
    "status_not": [500],
    "audit_not_contains": ["flk_sk_"]
  },
  "notes": "The response carries the secret exactly once (only the SHA-256 hash is stored); the audit row records actor/action/outcome plus name+role — key material never enters the trail."
}
