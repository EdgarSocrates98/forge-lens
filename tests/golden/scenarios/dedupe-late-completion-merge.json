{
  "scenario_id": "dedupe-late-completion-merge",
  "title": "A late end_time merges into the stored span and clears missing_end",
  "category": "dedupe",
  "setup": {
    "ingest_traces": [
      {
        "trace_id": "cccccccccccccccccccccccccccccccc",
        "root_span_id": "4444444444444444",
        "started_at": "2026-01-01T12:00:00Z",
        "ended_at": null,
        "spans": [
          {
            "trace_id": "cccccccccccccccccccccccccccccccc",
            "span_id": "4444444444444444",
            "name": "in-flight",
            "start_time": "2026-01-01T12:00:00Z",
            "end_time": null,
            "status": {"code": "unset"}
          }
        ]
      }
    ]
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "cccccccccccccccccccccccccccccccc",
              "root_span_id": "4444444444444444",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.100000Z",
              "spans": [
                {
                  "trace_id": "cccccccccccccccccccccccccccccccc",
                  "span_id": "4444444444444444",
                  "name": "in-flight",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"accepted_spans": 0, "updated_spans": 1, "duplicate_spans": 0},
    "store": {
      "trace_count": 1,
      "span_count": 1,
      "traces": {
        "cccccccccccccccccccccccccccccccc": {
          "ended_at": "2026-01-01T12:00:00.100000Z",
          "status": {"code": "ok"}
        }
      },
      "spans": {
        "cccccccccccccccccccccccccccccccc/4444444444444444": {
          "end_time": "2026-01-01T12:00:00.100000Z"
        }
      },
      "span_flags": {
        "cccccccccccccccccccccccccccccccc/4444444444444444": ["partial_trace"]
      },
      "span_flag_absent": {
        "cccccccccccccccccccccccccccccccc/4444444444444444": ["missing_end"]
      }
    }
  },
  "forbidden": {"status_not": [500]},
  "notes": "Changed content merges instead of duplicating: updated_spans=1. Documented quirk: 'missing_end' is cleared by the merge but 'partial_trace' persists on the span — flag-refresh only retires missing_parent/orphan/missing_end, so the partial evidence survives completion."
}
