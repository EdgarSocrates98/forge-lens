{
  "scenario_id": "dedupe-identical-reingest",
  "title": "Identical re-delivery is idempotent: duplicates counted, DUPLICATE flag evidence",
  "category": "dedupe",
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "dddddddddddddddddddddddddddddddd",
              "root_span_id": "1111111111111111",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.200000Z",
              "spans": [
                {
                  "trace_id": "dddddddddddddddddddddddddddddddd",
                  "span_id": "1111111111111111",
                  "name": "root",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.200000Z",
                  "status": {"code": "ok"}
                },
                {
                  "trace_id": "dddddddddddddddddddddddddddddddd",
                  "span_id": "2222222222222222",
                  "parent_span_id": "1111111111111111",
                  "name": "child",
                  "start_time": "2026-01-01T12:00:00.010000Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      },
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "dddddddddddddddddddddddddddddddd",
              "root_span_id": "1111111111111111",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.200000Z",
              "spans": [
                {
                  "trace_id": "dddddddddddddddddddddddddddddddd",
                  "span_id": "1111111111111111",
                  "name": "root",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.200000Z",
                  "status": {"code": "ok"}
                },
                {
                  "trace_id": "dddddddddddddddddddddddddddddddd",
                  "span_id": "2222222222222222",
                  "parent_span_id": "1111111111111111",
                  "name": "child",
                  "start_time": "2026-01-01T12:00:00.010000Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "statuses": [200, 200],
    "responses": [
      {"json": {"accepted_spans": 2, "updated_spans": 0, "duplicate_spans": 0}},
      {"json": {"accepted_spans": 0, "updated_spans": 0, "duplicate_spans": 2}}
    ],
    "store": {
      "trace_count": 1,
      "span_count": 2,
      "span_flags": {
        "dddddddddddddddddddddddddddddddd/1111111111111111": ["duplicate"],
        "dddddddddddddddddddddddddddddddd/2222222222222222": ["duplicate"]
      }
    }
  },
  "forbidden": {"status_not": [500]},
  "notes": "Same span_hash → identical re-delivery counts as duplicate and leaves a 'duplicate' integrity flag on the stored span (the retry is evidence). Still exactly one stored trace."
}
