{
  "scenario_id": "mcp-tool-argument-error",
  "title": "A tools/call with bad arguments reports invalid-params, never internal text",
  "category": "mcp",
  "input": {
    "op": "mcp",
    "frames": [
      {"jsonrpc": "2.0", "id": 1, "method": "initialize"},
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {"name": "lens.get_trace", "arguments": {}}
      },
      {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {"name": "lens.get_trace", "arguments": {"trace_id": 42}}
      }
    ]
  },
  "expected": {
    "output": {
      "1": {"result": {"serverInfo": {"name": "forge-lens"}}},
      "2": {"error": {"code": -32602}},
      "3": {"error": {"code": -32602}},
      "_rc": 0
    },
    "output_contains": {
      "2.error.message": ["invalid params"],
      "3.error.message": ["invalid params"]
    }
  },
  "forbidden": {
    "output_not_contains": ["tool error:", "must be a non-empty string", "trace_id must"]
  },
  "notes": "A malformed call never kills the stdio loop and never leaks internals: argument-validation TypeErrors map to -32602 with the static 'invalid params' message — exception/argument detail stays off the wire because it can embed payload fragments, and the server keeps serving (rc=0)."
}
