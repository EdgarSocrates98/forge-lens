{
  "scenario_id": "sanitize-secret-value-pattern",
  "title": "Credential-shaped values under innocuous keys are scrubbed inline",
  "category": "sanitize",
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "POST",
        "path": "/v1/traces",
        "json": {
          "traces": [
            {
              "trace_id": "acacacacacacacacacacacacacacacac",
              "root_span_id": "1010101010101010",
              "started_at": "2026-01-01T12:00:00Z",
              "ended_at": "2026-01-01T12:00:00.100000Z",
              "spans": [
                {
                  "trace_id": "acacacacacacacacacacacacacacacac",
                  "span_id": "1010101010101010",
                  "name": "debug",
                  "start_time": "2026-01-01T12:00:00Z",
                  "end_time": "2026-01-01T12:00:00.100000Z",
                  "attributes": {
                    "debug.note": "leaked sk-ant-api03-abcdefghijklmnopqrstuvwxyz here"
                  },
                  "status": {"code": "ok"}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "status": 200,
    "json": {"accepted_spans": 1, "sanitize": {"redacted_values": 1}},
    "store": {
      "span_attrs": {
        "acacacacacacacacacacacacacacacac/1010101010101010": {
          "debug.note": "leaked [REDACTED:anthropic-key] here"
        }
      }
    }
  },
  "forbidden": {
    "body_not_contains": ["sk-ant-api03-abcdefghijklmnopqrstuvwxyz"],
    "store_json_not_contains": ["sk-ant-api03-abcdefghijklmnopqrstuvwxyz"]
  },
  "notes": "VALUE_PATTERNS catches known token shapes inside otherwise-safe keys — the whole point of the value layer (see redact.py's comment about unanchored key matching being unaffordable)."
}
