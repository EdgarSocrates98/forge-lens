{
  "scenario_id": "tenancy-cross-project-read",
  "title": "A tenant-a key cannot read a trace stored under tenant-b — 403, no leak",
  "category": "tenancy",
  "setup": {
    "config": {"auth_mode": "keys"},
    "api_keys": [
      {
        "key_id": "flk_scopeda",
        "name": "scoped-reader",
        "secret": "flk_test_scoped_a",
        "role": "reader",
        "projects": ["tenant-a"]
      }
    ],
    "ingest_traces": [
      {
        "trace_id": "d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4",
        "project_id": "tenant-b",
        "started_at": "2026-01-01T12:00:00Z",
        "ended_at": "2026-01-01T12:00:00.100000Z",
        "spans": [
          {
            "trace_id": "d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4",
            "span_id": "1212121212121212",
            "name": "tenant-b-root",
            "start_time": "2026-01-01T12:00:00Z",
            "end_time": "2026-01-01T12:00:00.100000Z",
            "status": {"code": "ok"}
          }
        ]
      }
    ]
  },
  "input": {
    "op": "http",
    "requests": [
      {
        "method": "GET",
        "path": "/v1/traces/d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4",
        "params": {"project_id": "tenant-b"},
        "headers": {"X-Forge-Lens-Key": "flk_test_scoped_a"}
      }
    ]
  },
  "expected": {
    "status": 403,
    "body_contains": ["outside key scope"]
  },
  "forbidden": {
    "status_not": [200, 500],
    "body_not_contains": ["tenant-b-root"]
  },
  "notes": "Scope is checked before the store read — a 403 carries only the refusal, never the trace. In `keys` mode reads always need a key; tenant isolation holds for query endpoints too."
}
