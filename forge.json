{
  "forge_id": "forge-lens",
  "package": "forge_lens",
  "distribution": "forge-lens",
  "cli": "forge-lens",
  "python": ">=3.11",
  "extras": [
    "server"
  ],
  "mcp_server_name": "forge-lens",
  "mcp_command": [
    "forge-lens",
    "mcp-serve"
  ],
  "install_command": [
    "{python}",
    "-m",
    "forge_lens",
    "install"
  ],
  "lab": {
    "command": [
      "{python}",
      "scripts/lab/forge_lens_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "forge-lens-lab",
    "timeout_s": 300
  }
}
