{
  "$defs": {
    "ExperimentCohort": {
      "additionalProperties": true,
      "description": "One side of an A/B experiment \u2014 a declared set of trace ids.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Trace Ids",
          "type": "array"
        }
      },
      "title": "ExperimentCohort",
      "type": "object"
    },
    "ExperimentCohorts": {
      "additionalProperties": true,
      "description": "The two sides of the comparison \u2014 ``a`` baseline, ``b`` candidate.",
      "properties": {
        "a": {
          "$ref": "#/$defs/ExperimentCohort"
        },
        "b": {
          "$ref": "#/$defs/ExperimentCohort"
        }
      },
      "title": "ExperimentCohorts",
      "type": "object"
    },
    "Provenance": {
      "description": "How a piece of information arrived at the platform.",
      "enum": [
        "observed",
        "imported",
        "derived",
        "inferred",
        "unknown"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "$id": "https://forge-lens.dev/schemas/v1/experiment.json",
  "additionalProperties": true,
  "description": "A persisted, re-runnable A/B evaluation spec.",
  "properties": {
    "cohorts": {
      "$ref": "#/$defs/ExperimentCohorts"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "dataset_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "dataset_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Version"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "evaluators": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 100,
      "title": "Evaluators",
      "type": "array"
    },
    "experiment_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "project_id": {
      "default": "default",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "default": "imported"
    },
    "result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Ref"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "experiment_id"
  ],
  "title": "Experiment",
  "type": "object",
  "x-schema-version": "1.0.0"
}
