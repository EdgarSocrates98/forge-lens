{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-lens",
  "version": "0.2.0",
  "cli": "forge-lens",
  "cli_entry": "forge_lens.cli.main:main",
  "workflows": [
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": ["{cli}", "doctor", "{path}"],
      "description": "Check local Forge Lens installation and store health",
      "read_only": true
    },
    {
      "id": "capabilities",
      "mode": "DIAGNOSTIC_ONLY",
      "command": ["{cli}", "capabilities"],
      "description": "Report the verified host adapter capability matrix",
      "read_only": true
    },
    {
      "id": "stats",
      "mode": "DIAGNOSTIC_ONLY",
      "command": ["{cli}", "stats"],
      "description": "Summarize bounded local trace operations and failures",
      "read_only": true
    },
    {
      "id": "mcp-observer",
      "mode": "DIRECT_CAPABILITY",
      "command": ["{cli}", "mcp-serve"],
      "description": "Serve the local read-only MCP observer over stdio",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [],
  "coordinators": [],
  "mcp_command": ["{cli}", "mcp-serve"],
  "host_adapters": ["claude"],
  "read_only_default": true,
  "requires_credentials": false,
  "requires_network": false
}
